        "summary": "Authenticate signature through PayPal, persist/deduplicate then schedule reads",
        "operationId": "postWebhooksPaypal",
        "security": [],
        "parameters": [
          {
            "name": "PAYPAL-AUTH-ALGO",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          {
            "name": "PAYPAL-CERT-URL",
